<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 拖动条 -->
        <View
            android:id="@+id/drag_bar"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#444444"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- 顶部大卡片（当前用户/账号信息） -->
        <LinearLayout
            android:id="@+id/menu_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/menu_big_card_bg"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YSH 浏览器"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="极致轻量 · Material 风格"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第一行：书签 / 添加书签 / 历史 / 管理历史 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <include
                android:id="@+id/card_bookmark"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="6dp" />

            <include
                android:id="@+id/card_add_bookmark"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="6dp" />

            <include
                android:id="@+id/card_history"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="6dp" />

            <include
                android:id="@+id/card_manage_history"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 第二行：设置 / 分享网页 / 无痕 / 添加桌面 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <include
                android:id="@+id/card_settings"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="6dp" />

            <include
                android:id="@+id/card_share"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="6dp" />

            <include
                android:id="@+id/card_incognito"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="6dp" />

            <include
                android:id="@+id/card_shortcut"
                layout="@layout/item_menu_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 底部退出 -->
        <LinearLayout
            android:id="@+id/menu_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/menu_exit_bg"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_exit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="退出"
                android:textSize="16sp"
                android:textColor="#CF6679"
                android:layout_marginLeft="16dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
